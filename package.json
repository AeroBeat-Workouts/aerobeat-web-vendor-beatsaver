{
  "name": "@aerobeat/web-vendor-beatsaver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/",
    "README.md",
    "LICENSE.md",
    "docs/decisions/"
  ],
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "check": "npm run check:types && npm run check:jsdoc && npm run check:imports && npm run check:components && npm run check:contract",
    "check:types": "tsc --noEmit --allowJs --checkJs --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM src/*.js .testbed/demo/main.js",
    "check:jsdoc": "node scripts/validate-jsdoc-no-any.js",
    "check:imports": "node scripts/validate-public-imports.js",
    "check:components": "node scripts/validate-component-rules.js",
    "check:contract": "node scripts/validate-vendor-contract.js",
    "test": "npm run check && npm run test:unit",
    "test:unit": "node scripts/validate-vendor-service.js && node scripts/validate-archive-security.js",
    "test:browser": "node scripts/validate-browser-smoke.js",
    "demo": "npm --prefix .testbed run demo",
    "testbed:serve": "npm --prefix .testbed run serve"
  },
  "devDependencies": {
    "playwright": "^1.46.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
